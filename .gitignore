eget
*.exe
eget-*
# Brand assets keep their eget- prefix in file names, so the release-binary
# rule above must not swallow them.
!assets/logo/**
!cmd/
!cmd/eget/
!cmd/eget/main.go
todo.txt
eget.1
/test/*
!/test/test_eget.go
!/test/eget.toml
!/test/make_latest_test.sh
.eget.toml
.claude/
.agents/
.worktrees/
.xenv.toml
dist/
# `//go:embed all:dist` in internal/app/web needs the directory to exist even in
# a checkout without a frontend build, so its .gitkeep placeholder stays tracked
# while every other file under it remains ignored build output.
!internal/app/web/dist/
internal/app/web/dist/*
!internal/app/web/dist/.gitkeep
node_modules/
tmp/
.gitnexus
